DATABASE_URL=sqlite:///prlens.db

# GitHub OAuth App (login + repo access)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App (legacy, for existing installations)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# JWT session signing key (generate: scripts/generate-keys.sh)
JWT_SECRET=

# AES-256-GCM encryption key for token storage (generate: scripts/generate-keys.sh)
ENCRYPTION_KEY=

# Email (SMTP for OTP delivery; "console" = print to logs, Resend = smtp.resend.com)
SMTP_HOST=console
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@prlens.dev
SMTP_USE_TLS=true

# LLM (global fallback; users can also set their own via /api/ai/config)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# URLs
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Sessions
SESSION_DURATION_HOURS=24

# Policy
SEVERITY_THRESHOLD_BLOCK=low
SEVERITY_THRESHOLD_WARN=medium
MIN_CONFIDENCE=0.3
MAX_DIFF_SIZE=5000
ENABLE_SECURITY=true
ENABLE_RELIABILITY=true
ENABLE_PERFORMANCE=true
ENABLE_TESTING=true
ENABLE_LLM=false
